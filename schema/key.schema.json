{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publisher key",
  "type": "object",
  "additionalProperties": false,
  "required": ["fingerprint", "publicKey", "publisher", "addedAt"],
  "properties": {
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "publicKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publisher": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "addedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
